  {
    "id": "goblet-squat",
    "name": "哑铃高脚杯深蹲",
    "equipment": "哑铃",
    "muscles": "腿部、臀部、核心",
    "setup": "双手把哑铃靠近胸前，双脚约与肩同宽。",
    "steps": [
      "吸气并保持躯干稳定。",
      "髋膝一起弯曲，下蹲到自己能控制的深度。",
      "膝盖朝脚尖方向移动，平稳站起。"
    ],
    "mistakes": [
      "不要为了深度而弓背。",
      "避免脚跟抬起或膝盖突然内扣。"
    ],
