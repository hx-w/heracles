  {
    "id": "bench-press",
    "name": "杠铃卧推",
    "equipment": "杠铃、卧推凳",
    "muscles": "胸部、肱三头肌",
    "setup": "双脚踩稳，眼睛位于杠铃下方；调整保护杆，重重量请安排保护。",
    "steps": [
      "肩胛稳定，握距略宽于肩。",
      "控制下放至舒适位置，前臂接近垂直。",
      "平稳推起，保持脚和躯干稳定。"
    ],
    "mistakes": [
      "不要弹胸或让臀部离凳。",
      "肩部疼痛时停止并调整。"
    ],
