# Server-side only. Never use VITE_* or browser storage for credentials.
DEEPSEEK_API_KEY=
# Runtime choices; no provider/model identity in coach prompts.
COACH_MODEL=deepseek-flash
COACH_PROVIDER=deepseek-official
GARMIN_REGION=cn
GARMIN_SYNC_SECONDS=300
HERACLES_PORT=8791
# Only needed with the optional Caddy production overlay.
HERACLES_DOMAIN=heracles.example.com
